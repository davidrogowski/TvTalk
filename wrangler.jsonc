{
  "name": "tvtalk",
  "compatibility_date": "2024-12-01",
  "workers_dev": true,
  "main": "worker.js",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "tvtalk.fun",     "custom_domain": true },
    { "pattern": "www.tvtalk.fun", "custom_domain": true }
  ]
}
